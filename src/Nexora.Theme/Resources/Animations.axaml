<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">
    <sys:TimeSpan x:Key="HoverDuration">0:0:0.1</sys:TimeSpan>
    <SolidColorBrush x:Key="TrackHoverBrush" Color="#23FFFFFF" />

    <sys:TimeSpan x:Key="FadeDuration">0:0:0.1</sys:TimeSpan>
    <x:Double x:Key="TrackCoverHoverOpacity">0.5</x:Double>

    <sys:TimeSpan x:Key="PopupOpenDuration">0:0:0.15</sys:TimeSpan>
    <sys:TimeSpan x:Key="PopupCloseDuration">0:0:0.1</sys:TimeSpan>
    <TransformOperations x:Key="PopupClosedTransform">scale(0.95)</TransformOperations>

    <sys:TimeSpan x:Key="FlyoutOpenDuration">0:0:0.12</sys:TimeSpan>

    <sys:TimeSpan x:Key="SegmentSlideDuration">0:0:0.2</sys:TimeSpan>

    <CubicEaseIn x:Key="DefaultEaseIn" />
    <CubicEaseOut x:Key="DefaultEaseOut" />
</ResourceDictionary>
