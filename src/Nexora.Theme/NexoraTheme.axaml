<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Nexora.Theme.NexoraTheme">

    <FluentTheme />
    
    <StyleInclude Source="avares://Nexora.Theme/Styles/Typography.axaml" />

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Nexora.Theme/Controls/Slider.axaml" />
                <ResourceInclude Source="avares://Nexora.Theme/Controls/TextBox.axaml" />
                
                <ResourceInclude Source="avares://Nexora.Theme/Resources/Colors.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
