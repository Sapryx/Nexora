<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Nexora.ViewModels"
             xmlns:converters="clr-namespace:Nexora.Converters"
             x:Class="Nexora.Controls.AudioTrackView"
             x:DataType="viewModels:AudioTrackVm"
             x:Name="Root">
    <UserControl.Resources>
        <converters:IsAudioTrackPlayingConverter x:Key="IsAudioTrackPlayingConverter" />
        <converters:IsAudioTrackActiveConverter x:Key="IsAudioTrackActiveConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button TextBlock">
            <Setter Property="Opacity"
                    Value="{Binding IsActive, Converter={StaticResource IsAudioTrackActiveConverter}}" />
        </Style>

        <Style Selector="Button:pointerover TextBlock">
            <Setter Property="Opacity"
                    Value="1" />
        </Style>
        
        <Style Selector="Button Border#HoverEffect">
            <Setter Property="Background" Value="Black" />
            <Setter Property="Opacity" Value="0.0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        
        <Style Selector="Button:pointerover Border#HoverEffect">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Grid
        ColumnDefinitions="Auto, *, Auto"
        VerticalAlignment="Center"
        HorizontalAlignment="Stretch"
        ColumnSpacing="8">
        <Button Grid.Column="0"
                x:Name="TogglePlayButton"
                IsVisible="{Binding #Root.IsInteractive}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="{Binding PressPlayButton}"
                Cursor="Hand"
                Padding="0"
                CornerRadius="4">
            <Panel>
                <Border CornerRadius="4" ClipToBounds="True">
                    <Image Source="{Binding TrackCover}" 
                           Width="64" 
                           Height="64" />
                </Border>
                
                <Border x:Name="HoverEffect" CornerRadius="4" />
                
                <TextBlock
                    Text="{Binding IsActiveAndPlaying,Converter={StaticResource IsAudioTrackPlayingConverter}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    FontWeight="Bold" />
            </Panel>
        </Button>
        
        <Border Grid.Column="0"
            IsVisible="{Binding !#Root.IsInteractive}">
            <Border CornerRadius="4" ClipToBounds="True">
                <Image Source="{Binding TrackCover}" 
                       Width="64" 
                       Height="64" />
            </Border>
        </Border>
        
        <StackPanel Grid.Column="1"
                    Orientation="Vertical"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
            <TextBlock 
                Classes="Title" 
                Text="{Binding Title}" />
            
            <TextBlock Classes="Subtitle" 
                       Text="{Binding Artists}" />
        </StackPanel>
        <TextBlock Grid.Column="2" 
                   Text="{Binding Duration}"
                   Classes="Subtitle"
                   VerticalAlignment="Center" 
                   IsVisible="{Binding #Root.ShowDuration}"/>
    </Grid>
</UserControl>
