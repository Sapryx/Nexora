<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Nexora.ViewModels"
             xmlns:controls="clr-namespace:Nexora.Controls"
             x:Class="Nexora.Controls.TrackEditor"
             x:DataType="viewModels:TrackEditorVm">
    <UserControl.Styles>
        <Style Selector="Panel#Backdrop">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="{StaticResource PopupCloseDuration}"
                                      Easing="{StaticResource DefaultEaseIn}" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Panel#Backdrop[Tag=True]">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="{StaticResource PopupOpenDuration}"
                                      Easing="{StaticResource DefaultEaseOut}" />
                </Transitions>
            </Setter>
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Border#Dialog">
            <Setter Property="RenderTransform" Value="{StaticResource PopupClosedTransform}" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="{StaticResource PopupCloseDuration}"
                                                   Easing="{StaticResource DefaultEaseIn}" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Panel#Backdrop[Tag=True] Border#Dialog">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="{StaticResource PopupOpenDuration}"
                                                   Easing="{StaticResource DefaultEaseOut}" />
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>

        <Style Selector="TextBox.Field">
            <Setter Property="Background" Value="rgba(0, 0, 0, 25%)" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="ListBox#SuggestionList ListBoxItem">
            <Setter Property="Padding" Value="10 0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="ListBox#SuggestionList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        </Style>
    </UserControl.Styles>

    <Panel x:Name="Backdrop"
           Tag="{Binding TrackVm, Converter={x:Static ObjectConverters.IsNotNull}}"
           IsVisible="False"
           Background="rgba(0, 0, 0, 60%)">
        <Border x:Name="Dialog"
                Width="640"
                Margin="32"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="16"
                Background="#1E1E1E"
                BorderThickness="1"
                BorderBrush="{StaticResource BorderBrush}"
                BoxShadow="0 16 48 0 #99000000">
            <StackPanel Spacing="20">
                <Grid ColumnDefinitions="* Auto">
                    <TextBlock Grid.Column="0"
                               Classes="Title"
                               FontWeight="SemiBold"
                               Text="Track info"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Command="{Binding CancelCommand}"
                            CornerRadius="100"
                            Padding="4"
                            Background="Transparent"
                            ToolTip.Tip="Close">
                        <controls:Icon IconName="cross" />
                    </Button>
                </Grid>

                <Grid ColumnDefinitions="Auto *"
                      ColumnSpacing="24">
                    <Border Grid.Column="0"
                            CornerRadius="12"
                            ClipToBounds="True"
                            VerticalAlignment="Top">
                        <Image Source="{Binding TrackVm.Cover}"
                               Width="240"
                               Height="240"
                               Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Spacing="16"
                                IsEnabled="{Binding IsEditable}">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="Subtitle" Text="Title" />
                            <TextBox x:Name="TitleBox"
                                     Classes="Field"
                                     Text="{Binding EditedTitle}" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="Subtitle" Text="Artists" />
                            <Border x:Name="ArtistsBox"
                                    Padding="4"
                                    CornerRadius="8"
                                    Background="rgba(0, 0, 0, 25%)"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource BorderBrush}">
                                <StackPanel Spacing="4">
                                    <ItemsControl ItemsSource="{Binding EditedArtists}"
                                                  IsVisible="{Binding !!EditedArtists.Count}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel ItemSpacing="4"
                                                           LineSpacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Height="26"
                                                        Padding="10 0 4 0"
                                                        CornerRadius="13"
                                                        Background="#3A3A3A">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="2">
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center" />

                                                        <Button Click="OnRemoveArtistClick"
                                                                Width="20"
                                                                Height="20"
                                                                Padding="5"
                                                                CornerRadius="10"
                                                                Background="Transparent"
                                                                ToolTip.Tip="Remove">
                                                            <controls:Icon IconName="cross" />
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBox x:Name="ArtistInput"
                                             Text="{Binding ArtistQuery}"
                                             PlaceholderText="Add artist"
                                             FontSize="13"
                                             MinHeight="26"
                                             Padding="6 0"
                                             VerticalContentAlignment="Center"
                                             BorderThickness="0"
                                             Background="Transparent" />
                                </StackPanel>
                            </Border>

                            <Popup IsOpen="{Binding HasSuggestions}"
                                   PlacementTarget="{Binding #ArtistsBox}"
                                   Placement="BottomEdgeAlignedLeft"
                                   VerticalOffset="4"
                                   Width="{Binding #ArtistsBox.Bounds.Width}">
                                <Border Padding="4"
                                        CornerRadius="8"
                                        Background="#262626"
                                        BorderThickness="1"
                                        BorderBrush="{StaticResource BorderBrush}">
                                    <ListBox x:Name="SuggestionList"
                                             ItemsSource="{Binding Suggestions}"
                                             SelectedIndex="{Binding SelectedSuggestionIndex}"
                                             Background="Transparent"
                                             Tapped="OnSuggestionTapped">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:ArtistSuggestion">
                                                <Grid ColumnDefinitions="* Auto"
                                                      ColumnSpacing="8">
                                                    <TextBlock Grid.Column="0"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Match}" FontWeight="SemiBold" />
                                                        <Run Text="{Binding Rest}" />
                                                    </TextBlock>

                                                    <TextBlock Grid.Column="1"
                                                               Classes="Subtitle"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding Details}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Padding="20 8"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="{StaticResource BorderBrush}" />

                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            Padding="20 8"
                            CornerRadius="8"
                            FontWeight="SemiBold"
                            Background="{StaticResource PrimaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
