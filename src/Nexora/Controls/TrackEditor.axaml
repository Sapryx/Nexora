<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Nexora.ViewModels"
             xmlns:controls="clr-namespace:Nexora.Controls"
             x:Class="Nexora.Controls.TrackEditor"
             x:DataType="viewModels:TrackEditorVm">
    <Border Width="320"
            Padding="16"
            IsVisible="{Binding TrackVm, Converter={x:Static ObjectConverters.IsNotNull}}"
            Background="rgba(0, 0, 0, 25%)">
        <DockPanel>
            <Grid DockPanel.Dock="Top"
                  ColumnDefinitions="* Auto"
                  Margin="0 0 0 16">
                <TextBlock Grid.Column="0"
                           Classes="Title"
                           FontWeight="SemiBold"
                           Text="Track info"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Command="{Binding CloseCommand}"
                        CornerRadius="100"
                        Padding="4"
                        Background="Transparent"
                        ToolTip.Tip="Close">
                    <controls:Icon IconName="cross" />
                </Button>
            </Grid>

            <ScrollViewer>
                <StackPanel DataContext="{Binding TrackVm}"
                            x:DataType="viewModels:TrackControlVm"
                            Spacing="16">
                    <Border CornerRadius="12"
                            ClipToBounds="True">
                        <Image Source="{Binding Cover}"
                               Width="288"
                               Height="288"
                               Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="Subtitle" Text="Title" />
                        <TextBox Text="{Binding EditedTitle}"
                                 LostFocus="OnFieldLostFocus" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="Subtitle" Text="Artists" />
                        <TextBox Text="{Binding EditedArtists}"
                                 LostFocus="OnFieldLostFocus" />
                    </StackPanel>

                    <Grid ColumnDefinitions="* Auto">
                        <TextBlock Grid.Column="0" Classes="Subtitle" Text="Duration" />
                        <TextBlock Grid.Column="1" Classes="Title" Text="{Binding Duration}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                IsVisible="{Binding HasUnsavedChanges}">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{StaticResource TitleBrush}"
                                 VerticalAlignment="Center" />

                        <TextBlock Classes="Subtitle" Text="Unsaved changes" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
