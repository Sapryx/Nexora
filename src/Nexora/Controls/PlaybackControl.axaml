<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Nexora.Controls"
             xmlns:viewModels="clr-namespace:Nexora.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="1024"
             x:Class="Nexora.Controls.PlaybackControl"
             x:DataType="viewModels:PlaybackVm">
    <StackPanel Orientation="Vertical">
        <Slider x:Name="PlaybackPositionSlider"
                Value="{Binding PlaybackPosition, Mode=TwoWay}"
                Minimum="0"
                Maximum="1"
                HorizontalAlignment="Stretch"
                Margin="12 0"
                CornerRadius="8 8 0 0" />
        <Border Background="#2C2C2C"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{StaticResource BorderBrush}"
                Padding="16 8">
            <Grid ColumnDefinitions="* Auto *">
                <Border Grid.Column="0">
                    <Grid RowDefinitions="Auto Auto"
                          ColumnDefinitions="Auto Auto"
                          RowSpacing="8"
                          ColumnSpacing="16">
                        <Image Grid.Row="0"
                               Grid.Column="0"
                               Grid.RowSpan="2"
                               Source="C:\Users\sapryx\Pictures\wallhaven-1pvr23-scaled.png"
                               Width="64" />

                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   VerticalAlignment="Bottom"
                                   Text="Weightless"
                                   FontSize="16" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="Ari Xorka"
                                   VerticalAlignment="Top" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">

                    <Button Command="{Binding PressPreviousTrackButton}"
                            CornerRadius="100"
                            Padding="8">
                        <controls:Icon IconName="skip_back" />
                    </Button>

                    <Button Command="{Binding PressPauseButton}"
                            CornerRadius="100"
                            Padding="8">
                        <Panel>
                            <controls:Icon IconName="pause"
                                           IsVisible="{Binding IsPlaying}" />

                            <controls:Icon IconName="play"
                                           IsVisible="{Binding !IsPlaying}" />
                        </Panel>
                    </Button>

                    <Button Command="{Binding PressNextTrackButton}"
                            CornerRadius="100"
                            Padding="8">
                        <controls:Icon IconName="skip_forward" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="16"
                            HorizontalAlignment="Right">
                    <controls:Icon IconName="speaker_loud" />
                    <Slider x:Name="VolumeSlider"
                            Value="{Binding Volume, Mode=TwoWay}"
                            Minimum="0"
                            Maximum="100"
                            Width="120"
                            Height="8" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
