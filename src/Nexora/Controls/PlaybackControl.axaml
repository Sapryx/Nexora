<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Nexora.Controls"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="1024"
             x:Class="Nexora.Controls.PlaybackControl">
    <Border>
        <StackPanel Orientation="Vertical">
            <Slider />
            <Border Background="#2C2C2C"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{StaticResource BorderBrush}"
                    BoxShadow="0 4 4 0 #40000000"
                    Padding="16 8">
                <Grid ColumnDefinitions="* Auto *">
                    <Border Grid.Column="0">
                        <Grid RowDefinitions="Auto Auto"
                              ColumnDefinitions="Auto Auto"
                              RowSpacing="8"
                              ColumnSpacing="16">
                            <Image Grid.Row="0"
                                   Grid.Column="0"
                                   Grid.RowSpan="2"
                                   Source="C:\Users\sapryx\Pictures\wallhaven-1pvr23-scaled.png"
                                   Width="64" />

                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       VerticalAlignment="Bottom"
                                       Text="Weightless" 
                                       FontSize="16"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="Ari Xorka"
                                       VerticalAlignment="Top" />
                        </Grid>
                    </Border>
                    
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                        
                        <controls:Icon IconName="skip_back" />
                        <controls:Icon IconName="pause" />
                        <controls:Icon IconName="skip_forward" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="16"
                                HorizontalAlignment="Right">
                        <controls:Icon IconName="speaker_loud" />
                        <Slider Width="120"
                                Height="8" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
