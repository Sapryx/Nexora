<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Nexora.ViewModels"
             xmlns:controls="clr-namespace:Nexora.Controls"
             x:Class="Nexora.Controls.TrackEditMenu"
             x:DataType="viewModels:TrackControlVm">
    <Panel>
        <Button x:Name="MenuButton"
                Click="OnMenuButtonClick"
                CornerRadius="100"
                Padding="4"
                Background="Transparent">
            <controls:Icon IconName="dots" />
        </Button>

        <Popup x:Name="EditorPopup"
               PlacementTarget="{Binding #MenuButton}"
               Placement="RightEdgeAlignedTop"
               HorizontalOffset="8"
               ShouldUseOverlayLayer="True">
            <Border CornerRadius="12"
                    ClipToBounds="True">
                <Border x:Name="EditorPanel"
                        Width="320"
                        Padding="16"
                        CornerRadius="12"
                        Background="#2B2B2B"
                        BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrush}">
                    <Grid ColumnDefinitions="Auto *"
                          RowDefinitions="Auto Auto"
                          ColumnSpacing="12"
                          RowSpacing="8">
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Classes="Subtitle"
                                   Text="Title"
                                   VerticalAlignment="Center" />

                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding EditedTitle}" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Classes="Subtitle"
                                   Text="Artists"
                                   VerticalAlignment="Center" />

                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding EditedArtists}" />
                    </Grid>
                </Border>
            </Border>
        </Popup>
    </Panel>
</UserControl>
