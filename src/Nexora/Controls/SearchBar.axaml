<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Nexora.Controls"
             xmlns:viewModels="clr-namespace:Nexora.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Nexora.Controls.SearchBar"
             x:DataType="viewModels:SearchBarVm">
    <Border CornerRadius="100"
            VerticalAlignment="Center"
            Background="rgba(255, 255, 255, 10%)"
            BorderThickness="1"
            BorderBrush="{StaticResource BorderBrush}"
            Padding="8 4">
        <Grid ColumnDefinitions="Auto *"
              ColumnSpacing="4">
            <controls:Icon Grid.Column="0"
                           IconName="magnifier" />

            <TextBox Grid.Column="1"
                     Classes="Title"
                     Text="{Binding SearchQuery}"
                     PlaceholderText="Search..."
                     VerticalAlignment="Center"
                     BorderThickness="0"
                     Background="Transparent" 
                     Padding="0"
                     Margin="0"

                     VerticalContentAlignment="Center">
                <TextBox.InnerRightContent>
                    <Button Command="{Binding ClearSearchQuery}"
                            IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Focusable="False"
                            CornerRadius="100"
                            Padding="0"
                            Background="Transparent">
                        <controls:Icon IconName="cross" />
                    </Button>
                </TextBox.InnerRightContent>
            </TextBox>
        </Grid>
    </Border>
</UserControl>
