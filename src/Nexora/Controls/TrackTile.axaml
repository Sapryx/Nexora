<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Nexora.ViewModels"
             xmlns:controls="clr-namespace:Nexora.Controls"
             x:Class="Nexora.Controls.TrackTile"
             x:DataType="viewModels:TrackControlVm">

    <UserControl.Styles>
        <Style Selector="Border#MainTrackBorder">
            <Setter Property="Background" Value="#00000000" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border#MainTrackBorder[Tag=True]">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <Style Selector="Panel#IconPanel">
            <Setter Property="IsVisible" Value="{Binding IsActive}" />
        </Style>

        <Style Selector="Button:pointerover Panel#IconPanel">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="Button Border#HoverEffect">
            <Setter Property="Background" Value="Black" />
            <Setter Property="Opacity" Value="0.0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button:pointerover Border#HoverEffect">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <Style Selector="Button#TogglePlayButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="controls|TrackEditMenu#EditMenu">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="Border#MainTrackBorder:pointerover controls|TrackEditMenu#EditMenu,
                         controls|TrackEditMenu#EditMenu:open">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Border x:Name="MainTrackBorder"
            Tag="{Binding IsActive}"
            HorizontalAlignment="Center"
            Padding="8"
            CornerRadius="12">
        <Border.ContextFlyout>
            <MenuFlyout>
                <MenuItem Header="Add To Queue"
                          Command="{Binding AddToQueueCommand}"
                          IsVisible="{Binding !IsInQueue}" />
                <MenuItem Header="Remove From Queue"
                          Command="{Binding RemoveFromQueueCommand}"
                          IsVisible="{Binding IsInQueue}" />
            </MenuFlyout>
        </Border.ContextFlyout>

        <StackPanel Width="160"
                    Spacing="8">
            <Panel>
                <Button x:Name="TogglePlayButton"
                        Command="{Binding PressPlayButton}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Padding="0"
                        CornerRadius="8"
                        BorderThickness="0">
                    <Panel>
                        <Border CornerRadius="8"
                                ClipToBounds="True">
                            <Image Source="{Binding Cover}"
                                   Width="160"
                                   Height="160" />
                        </Border>

                        <Border x:Name="HoverEffect" CornerRadius="8" />

                        <Panel x:Name="IconPanel"
                               RenderTransform="scale(2)">
                            <controls:Icon IsVisible="{Binding IsActiveAndPlaying}"
                                           IconName="pause" />

                            <controls:Icon IsVisible="{Binding !IsActiveAndPlaying}"
                                           IconName="play" />
                        </Panel>
                    </Panel>
                </Button>

                <controls:TrackEditMenu x:Name="EditMenu"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="4"
                                        Background="rgba(0, 0, 0, 50%)"
                                        CornerRadius="100" />
            </Panel>

            <StackPanel Spacing="2">
                <Grid ColumnDefinitions="*, Auto"
                      ColumnSpacing="6"
                      HorizontalAlignment="Center">
                    <TextBlock Grid.Column="0"
                               Classes="Title"
                               Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis" />

                    <Ellipse Grid.Column="1"
                             Width="8"
                             Height="8"
                             Fill="{StaticResource TitleBrush}"
                             VerticalAlignment="Center"
                             IsVisible="{Binding HasUnsavedChanges}"
                             ToolTip.Tip="Unsaved changes" />
                </Grid>

                <TextBlock Classes="Subtitle"
                           Text="{Binding Artists}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
