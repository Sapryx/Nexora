<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Nexora.ViewModels"
             xmlns:controls="clr-namespace:Nexora.Controls"
             x:Class="Nexora.Controls.TrackTile"
             x:DataType="viewModels:TrackControlVm">

    <UserControl.Resources>
        <MenuFlyout x:Key="TrackMenu">
            <MenuItem Header="Add To Queue"
                      Command="{Binding AddToQueueCommand}"
                      IsVisible="{Binding !IsInQueue}" />
            <MenuItem Header="Remove From Queue"
                      Command="{Binding RemoveFromQueueCommand}"
                      IsVisible="{Binding IsInQueue}" />
        </MenuFlyout>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border#MainTrackBorder">
            <Setter Property="Background" Value="#00000000" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="{StaticResource HoverDuration}" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border#MainTrackBorder:pointerover">
            <Setter Property="Background" Value="{StaticResource TrackHoverBrush}" />
        </Style>

        <Style Selector="Border#MainTrackBorder[Tag=True]">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <Style Selector="Panel#IconPanel">
            <Setter Property="IsVisible" Value="{Binding IsActive}" />
        </Style>

        <Style Selector="Button:pointerover Panel#IconPanel">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="Button Border#HoverEffect">
            <Setter Property="Background" Value="Black" />
            <Setter Property="Opacity" Value="0.0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="{StaticResource FadeDuration}" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button:pointerover Border#HoverEffect">
            <Setter Property="Opacity" Value="{StaticResource TrackCoverHoverOpacity}" />
        </Style>

        <Style Selector="Button#TogglePlayButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button#MenuButton">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="Border#MainTrackBorder:pointerover Button#MenuButton">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Border x:Name="MainTrackBorder"
            Tag="{Binding IsActive}"
            ContextFlyout="{StaticResource TrackMenu}"
            HorizontalAlignment="Center"
            Padding="8"
            CornerRadius="12">
        <StackPanel Width="160"
                    Spacing="8">
            <Panel>
                <Button x:Name="TogglePlayButton"
                        Command="{Binding PressPlayButton}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Padding="0"
                        CornerRadius="8"
                        BorderThickness="0">
                    <Panel>
                        <Border CornerRadius="8"
                                ClipToBounds="True">
                            <Image Source="{Binding Cover}"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"
                                   Width="160"
                                   Height="160" />
                        </Border>

                        <Border x:Name="HoverEffect" CornerRadius="8" />

                        <Panel x:Name="IconPanel"
                               RenderTransform="scale(2)">
                            <controls:Icon IsVisible="{Binding IsActiveAndPlaying}"
                                           IconName="pause" />

                            <controls:Icon IsVisible="{Binding !IsActiveAndPlaying}"
                                           IconName="play" />
                        </Panel>
                    </Panel>
                </Button>

                <Button x:Name="MenuButton"
                        Flyout="{StaticResource TrackMenu}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="4"
                        Padding="4"
                        Background="rgba(0, 0, 0, 50%)"
                        CornerRadius="100"
                        ToolTip.Tip="More">
                    <controls:Icon IconName="dots" />
                </Button>
            </Panel>

            <StackPanel Spacing="2">
                <TextBlock Classes="Title"
                           Text="{Binding Title}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Classes="Subtitle"
                           Text="{Binding Artists}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
