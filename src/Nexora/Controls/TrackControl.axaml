<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Nexora.ViewModels"
             xmlns:controls="clr-namespace:Nexora.Controls"
             x:Class="Nexora.Controls.TrackControl"
             x:DataType="viewModels:TrackControlVm"
             x:Name="Root">

    <UserControl.Resources>
        <MenuFlyout x:Key="TrackMenu">
            <MenuItem Header="Add To Queue"
                      Command="{Binding AddToQueueCommand}"
                      IsVisible="{Binding !IsInQueue}" />
            <MenuItem Header="Remove From Queue"
                      Command="{Binding RemoveFromQueueCommand}"
                      IsVisible="{Binding IsInQueue}" />
        </MenuFlyout>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border#MainTrackBorder">
            <Setter Property="Background" Value="#00000000" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="{StaticResource HoverDuration}" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border#MainTrackBorder:pointerover">
            <Setter Property="Background" Value="{StaticResource TrackHoverBrush}" />
        </Style>

        <Style Selector="Border#MainTrackBorder[Tag=True]">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <Style Selector="Panel#IconPanel">
            <Setter Property="IsVisible" Value="{Binding IsActive}" />
        </Style>

        <Style Selector="Button:pointerover Panel#IconPanel">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="Button Border#HoverEffect">
            <Setter Property="Background" Value="Black" />
            <Setter Property="Opacity" Value="0.0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="{StaticResource FadeDuration}" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button:pointerover Border#HoverEffect">
            <Setter Property="Opacity" Value="{StaticResource TrackCoverHoverOpacity}" />
        </Style>

        <Style Selector="Button#TogglePlayButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Border x:Name="MainTrackBorder"
            Tag="{Binding IsActive}"
            ContextFlyout="{StaticResource TrackMenu}"
            Padding="8"
            CornerRadius="12">
        <Grid ColumnDefinitions="Auto, *, Auto, Auto"
              RowDefinitions="Auto Auto"
              ColumnSpacing="8"
              RowSpacing="4">

            <Button Grid.Column="0"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    x:Name="TogglePlayButton"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Command="{Binding PressPlayButton}"
                    Padding="0"
                    CornerRadius="4"
                    BorderThickness="0">
                <Panel>
                    <Border
                        CornerRadius="4"
                        ClipToBounds="True">
                        <Image Source="{Binding Cover}"
                               Width="64"
                               Height="64" />
                    </Border>

                    <Border x:Name="HoverEffect" CornerRadius="4" />

                    <Panel x:Name="IconPanel">
                        <controls:Icon IsVisible="{Binding IsActiveAndPlaying}"
                                       IconName="pause" />

                        <controls:Icon IsVisible="{Binding !IsActiveAndPlaying}"
                                       IconName="play" />
                    </Panel>
                </Panel>
            </Button>

            <TextBlock Grid.Column="1"
                       Grid.Row="0"
                       Classes="Title"
                       Text="{Binding Title}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Bottom" />

            <TextBlock Grid.Column="1"
                       Grid.Row="1"
                       Classes="Subtitle"
                       Text="{Binding Artists}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Top"/>

            <TextBlock Grid.Column="2"
                       Grid.Row="0"
                       Grid.RowSpan="2"
                       Text="{Binding Duration}"
                       Classes="Subtitle"
                       VerticalAlignment="Center" />

            <Button Grid.Column="3"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Flyout="{StaticResource TrackMenu}"
                    CornerRadius="100"
                    Padding="4"
                    Background="Transparent"
                    VerticalAlignment="Center"
                    ToolTip.Tip="More">
                <controls:Icon IconName="dots" />
            </Button>
        </Grid>
    </Border>
</UserControl>
