<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Nexora.ViewModels"
             xmlns:controls="clr-namespace:Nexora.Controls"
             x:Class="Nexora.Controls.AudioTrackView"
             x:DataType="viewModels:TrackControlVm"
             x:Name="Root">

    <UserControl.Styles>
        <Style Selector="Border#MainTrackBorder">
            <Setter Property="Background" Value="#00000000" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border#MainTrackBorder[Tag=True]">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <Style Selector="Panel#IconPanel">
            <Setter Property="IsVisible" Value="{Binding IsActive}" />
        </Style>

        <Style Selector="Button:pointerover Panel#IconPanel">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="Button Border#HoverEffect">
            <Setter Property="Background" Value="Black" />
            <Setter Property="Opacity" Value="0.0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button:pointerover Border#HoverEffect">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <Style Selector="Button#TogglePlayButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Border x:Name="MainTrackBorder"
            Tag="{Binding IsActive}"
            Padding="8"
            CornerRadius="12">
        <Border.ContextFlyout>
            <MenuFlyout>
                <MenuItem Header="Add To Queue"
                          Command="{Binding AddToQueueCommand}"
                          IsVisible="{Binding !IsInQueue}" />
                <MenuItem Header="Remove From Queue"
                          Command="{Binding RemoveFromQueueCommand}"
                          IsVisible="{Binding IsInQueue}" />
            </MenuFlyout>
        </Border.ContextFlyout>

        <Grid ColumnDefinitions="Auto, *, Auto, Auto"
              RowDefinitions="Auto Auto"
              ColumnSpacing="8"
              RowSpacing="4">

            <Button Grid.Column="0"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    x:Name="TogglePlayButton"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Command="{Binding PressPlayButton}"
                    Padding="0"
                    CornerRadius="4"
                    BorderThickness="0">
                <Panel>
                    <Border
                        CornerRadius="4"
                        ClipToBounds="True">
                        <Image Source="{Binding Cover}"
                               Width="64"
                               Height="64" />
                    </Border>

                    <Border x:Name="HoverEffect" CornerRadius="4" />

                    <Panel x:Name="IconPanel">
                        <controls:Icon IsVisible="{Binding IsActiveAndPlaying}"
                                       IconName="pause" />

                        <controls:Icon IsVisible="{Binding !IsActiveAndPlaying}"
                                       IconName="play" />
                    </Panel>
                </Panel>
            </Button>

            <StackPanel Grid.Column="1"
                        Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Bottom">
                <TextBlock Classes="Title"
                           Text="{Binding Title}" />

                <Ellipse Width="8"
                         Height="8"
                         Fill="{StaticResource TitleBrush}"
                         VerticalAlignment="Center"
                         IsVisible="{Binding HasUnsavedChanges}"
                         ToolTip.Tip="Unsaved changes" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Grid.Row="1"
                       Classes="Subtitle"
                       Text="{Binding Artists}"
                       VerticalAlignment="Top"/>

            <TextBlock Grid.Column="2"
                       Grid.Row="0"
                       Grid.RowSpan="2"
                       Text="{Binding Duration}"
                       Classes="Subtitle"
                       VerticalAlignment="Center" />

            <controls:TrackEditMenu Grid.Column="3"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
