<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Nexora.Theme;assembly=Nexora.Theme"
             x:Class="Nexora.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <theme:NexoraTheme />
    </Application.Styles>
</Application>
