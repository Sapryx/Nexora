<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Nexora.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Nexora.Controls"
        xmlns:views="clr-namespace:Nexora.Views"
        xmlns:render="clr-namespace:Nexora.Render"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="1024"
        x:Class="Nexora.Views.MainWindow"
        x:DataType="vm:MainWindowVm"
        Icon="/Assets/avalonia-logo.ico"
        Title="Nexora"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Focusable="True"
        Container.Name="main"
        Container.Sizing="Width">
    <Window.Styles>
        <ContainerQuery Name="main" Query="max-width:960">
            <Style Selector="Border#sidebar">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ContainerQuery>
    </Window.Styles>
    <Panel>
        <render:DitheringControl StartPoint="0% 0%" EndPoint="100% 100%">
            <render:DitheringControl.GradientStops>
                <GradientStop Color="#3D3D3D" Offset="0"/>
                <GradientStop Color="#191919" Offset="1"/>
            </render:DitheringControl.GradientStops>
        </render:DitheringControl>

        <DockPanel LastChildFill="True">
            <Border x:Name="sidebar"
                    DockPanel.Dock="Left"
                    Width="300"
                    Padding="16 16 0 16"
                    Background="rgba(0, 0, 0, 25%)">
                <DockPanel>
                    <controls:SegmentedControl DockPanel.Dock="Top"
                                               Margin="0 0 16 0">
                        <ListBoxItem Padding="10"
                                     ToolTip.Tip="Library">
                            <controls:Icon IconName="library" />
                        </ListBoxItem>
                    </controls:SegmentedControl>

                    <TextBlock DockPanel.Dock="Top"
                               Classes="Title"
                               FontWeight="SemiBold"
                               Text="Queue"
                               Margin="8 16 0 0" />

                    <Panel>
                        <views:TrackArea TrackVms="{Binding QueueVm.TrackVms}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch" />

                        <TextBlock Classes="Subtitle"
                                   Text="The queue is empty"
                                   IsVisible="{Binding QueueVm.IsEmpty}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Panel>
                </DockPanel>
            </Border>

            <Grid RowDefinitions="Auto * Auto"
                  Margin="0 16">
                <Panel Grid.Row="0">
                    <views:SearchBar DataContext="{Binding SearchBarVm}"
                                        HorizontalAlignment="Stretch"
                                        MaxWidth="480"
                                        Margin="136 0" />

                    <controls:SegmentedControl HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0 0 32 0"
                                               SelectedIndex="{Binding LibraryViewIndex}">
                        <ListBoxItem ToolTip.Tip="List">
                            <controls:Icon IconName="list" />
                        </ListBoxItem>

                        <ListBoxItem ToolTip.Tip="Grid">
                            <controls:Icon IconName="grid" />
                        </ListBoxItem>
                    </controls:SegmentedControl>
                </Panel>

                <Panel Grid.Row="1">
                    <views:TrackArea x:Name="LibraryList"
                                        Margin="32 0 0 0"
                                        TrackVms="{Binding SearchBarVm.DisplayedAudioTrackVms}"
                                        IsVisible="{Binding !IsLibraryGridView}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"/>

                    <views:TrackGrid x:Name="LibraryGrid"
                                        Margin="32 0 0 0"
                                        TrackVms="{Binding SearchBarVm.DisplayedAudioTrackVms}"
                                        FirstVisibleTrackIndex="{Binding #LibraryList.FirstVisibleTrackIndex}"
                                        IsVisible="{Binding IsLibraryGridView}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"/>
                </Panel>

                <views:PlaybackControl Grid.Row="2"
                                          DataContext="{Binding PlaybackVm}"
                                          VerticalAlignment="Bottom"
                                          HorizontalAlignment="Stretch"
                                          MaxWidth="960"
                                          Margin="48 0"/>
            </Grid>
        </DockPanel>

        <views:TrackEditor DataContext="{Binding TrackEditorVm}" />
    </Panel>
</Window>
