<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Nexora.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Nexora.Controls"
        xmlns:render="clr-namespace:Nexora.Render"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="1024"
        x:Class="Nexora.Views.MainWindow"
        x:DataType="vm:MainWindowVm"
        Icon="/Assets/avalonia-logo.ico"
        Title="Nexora"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Focusable="True"
        Container.Name="main"
        Container.Sizing="Width">
    <Window.Styles>
        <Style Selector="Border#sectionSwitcher Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style Selector="Border#sectionSwitcher Button.selected">
            <Setter Property="Background" Value="rgba(255, 255, 255, 15%)" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>

        <Style Selector="Border#viewToggle Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="100" />
            <Setter Property="Padding" Value="8 4" />
        </Style>

        <Style Selector="Border#viewToggle Button.selected">
            <Setter Property="Background" Value="rgba(255, 255, 255, 15%)" />
        </Style>

        <ContainerQuery Name="main" Query="max-width:960">
            <Style Selector="Border#sidebar">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ContainerQuery>
    </Window.Styles>
    <Panel>
        <render:DitheringControl StartPoint="0% 0%" EndPoint="100% 100%">
            <render:DitheringControl.GradientStops>
                <GradientStop Color="#3D3D3D" Offset="0"/>
                <GradientStop Color="#191919" Offset="1"/>
            </render:DitheringControl.GradientStops>
        </render:DitheringControl>

        <DockPanel LastChildFill="True">
            <!-- <Border -->
            <!--     DockPanel.Dock="Top" -->
            <!--     Height="32" -->
            <!--     HorizontalAlignment="Stretch" -->
            <!--     VerticalAlignment="Top" -->
            <!--     Background="rgba(0, 0, 0, 40%)"> -->
            <!-- -->
            <!-- </Border> -->

            <Border x:Name="sidebar"
                    DockPanel.Dock="Left"
                    Width="300"
                    Padding="16 16 0 16"
                    Background="rgba(0, 0, 0, 25%)">
                <DockPanel>
                    <Border x:Name="sectionSwitcher"
                            DockPanel.Dock="Top"
                            Margin="0 0 16 0"
                            Padding="4"
                            CornerRadius="12"
                            Background="rgba(255, 255, 255, 6%)"
                            BorderThickness="1"
                            BorderBrush="{StaticResource BorderBrush}">
                        <UniformGrid Rows="1" ColumnSpacing="4">
                            <Button Classes="selected"
                                    ToolTip.Tip="Library">
                                <controls:Icon IconName="library" />
                            </Button>
                        </UniformGrid>
                    </Border>

                    <TextBlock DockPanel.Dock="Top"
                               Classes="Title"
                               FontWeight="SemiBold"
                               Text="Queue"
                               Margin="8 16 0 0" />

                    <Panel>
                        <controls:TrackArea TrackVms="{Binding QueueVm.TrackVms}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch" />

                        <TextBlock Classes="Subtitle"
                                   Text="The queue is empty"
                                   IsVisible="{Binding QueueVm.IsEmpty}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Panel>
                </DockPanel>
            </Border>

            <controls:TrackEditor DockPanel.Dock="Right"
                                  DataContext="{Binding TrackEditorVm}" />

            <Grid RowDefinitions="Auto * Auto"
                  Margin="0 16">
                <Panel Grid.Row="0">
                    <controls:SearchBar DataContext="{Binding SearchBarVm}"
                                        HorizontalAlignment="Stretch"
                                        MaxWidth="480"
                                        Margin="136 0" />

                    <Border x:Name="viewToggle"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0 0 32 0"
                            Padding="4"
                            CornerRadius="100"
                            Background="rgba(255, 255, 255, 10%)"
                            BorderThickness="1"
                            BorderBrush="{StaticResource BorderBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Command="{Binding ShowLibraryListCommand}"
                                    Classes.selected="{Binding !IsLibraryGridView}"
                                    ToolTip.Tip="List">
                                <controls:Icon IconName="list" />
                            </Button>

                            <Button Command="{Binding ShowLibraryGridCommand}"
                                    Classes.selected="{Binding IsLibraryGridView}"
                                    ToolTip.Tip="Grid">
                                <controls:Icon IconName="grid" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Panel>

                <Panel Grid.Row="1">
                    <controls:TrackArea Margin="32 0 0 0"
                                        TrackVms="{Binding SearchBarVm.DisplayedAudioTrackVms}"
                                        IsVisible="{Binding !IsLibraryGridView}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"/>

                    <controls:TrackGrid Margin="32 0 0 0"
                                        TrackVms="{Binding SearchBarVm.DisplayedAudioTrackVms}"
                                        IsVisible="{Binding IsLibraryGridView}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"/>
                </Panel>

                <controls:PlaybackControl Grid.Row="2"
                                          DataContext="{Binding PlaybackVm}"
                                          VerticalAlignment="Bottom"
                                          HorizontalAlignment="Stretch"
                                          MaxWidth="960"
                                          Margin="48 0"/>
            </Grid>
        </DockPanel>
    </Panel>
</Window>
