<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Nexora.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Nexora.Controls"
        xmlns:render="clr-namespace:Nexora.Render"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="1024"
        x:Class="Nexora.Views.MainWindow"
        x:DataType="vm:MainWindowVm"
        Icon="/Assets/avalonia-logo.ico"
        Title="Nexora"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Focusable="True"
        Container.Name="main"
        Container.Sizing="Width">
    <Window.Styles>
        <Style Selector="Border#sidebar Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12 8" />
        </Style>

        <Style Selector="Border#sidebar Button.selected">
            <Setter Property="Background" Value="rgba(255, 255, 255, 10%)" />
        </Style>

        <ContainerQuery Name="main" Query="max-width:960">
            <Style Selector="Border#sidebar">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ContainerQuery>
    </Window.Styles>
    <Panel>
        <render:DitheringControl StartPoint="0% 0%" EndPoint="100% 100%">
            <render:DitheringControl.GradientStops>
                <GradientStop Color="#3D3D3D" Offset="0"/>
                <GradientStop Color="#191919" Offset="1"/>
            </render:DitheringControl.GradientStops>
        </render:DitheringControl>

        <DockPanel LastChildFill="True">
            <!-- <Border -->
            <!--     DockPanel.Dock="Top" -->
            <!--     Height="32" -->
            <!--     HorizontalAlignment="Stretch" -->
            <!--     VerticalAlignment="Top" -->
            <!--     Background="rgba(0, 0, 0, 40%)"> -->
            <!-- -->
            <!-- </Border> -->

            <Border x:Name="sidebar"
                    DockPanel.Dock="Left"
                    Width="240"
                    Padding="16"
                    Background="rgba(0, 0, 0, 25%)">
                <StackPanel Spacing="4">
                    <Button Command="{Binding OpenLibraryCommand}"
                            Classes.selected="{Binding !IsQueueOpen}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <controls:Icon IconName="library" />
                            <TextBlock Classes="Title" Text="Library" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenQueueCommand}"
                            Classes.selected="{Binding IsQueueOpen}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <controls:Icon IconName="queue" />
                            <TextBlock Classes="Title" Text="Queue" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Grid RowDefinitions="Auto * Auto"
                  Margin="0 16">
                <Panel Grid.Row="0"
                       IsVisible="{Binding !IsQueueOpen}">
                    <controls:SearchBar DataContext="{Binding SearchBarVm}"
                                        HorizontalAlignment="Stretch"
                                        MaxWidth="480" />
                </Panel>

                <controls:TrackArea Grid.Row="1"
                                    Margin="32 0 0 0"
                                    TrackVms="{Binding SearchBarVm.DisplayedAudioTrackVms}"
                                    IsVisible="{Binding !IsQueueOpen}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"/>

                <Panel Grid.Row="1"
                       IsVisible="{Binding IsQueueOpen}">
                    <controls:TrackArea Margin="32 0 0 0"
                                        TrackVms="{Binding QueueVm.TrackVms}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"/>

                    <TextBlock Classes="Subtitle"
                               Text="The queue is empty"
                               IsVisible="{Binding QueueVm.IsEmpty}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Panel>

                <controls:PlaybackControl Grid.Row="2"
                                          DataContext="{Binding PlaybackVm}"
                                          VerticalAlignment="Bottom"
                                          HorizontalAlignment="Stretch"
                                          MaxWidth="960"
                                          Margin="48 0"/>
            </Grid>
        </DockPanel>
    </Panel>
</Window>
